					"name": "1.1 Check Email",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Accept", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/check-email",
							"host": ["{{base_url}}"],
							"path": ["auth", "check-email"]
						}
					}
				},
